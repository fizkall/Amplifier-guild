rules_version = '2';

// Amplifier Guild — Firestore Güvenlik Kuralları
// İlke: Sayaçlar, doğrulanmış CV kalemleri ve başvuru kararları SADECE Cloud Functions
// (Admin SDK, kuralları bypass eder) tarafından yazılır. İstemci bunlara dokunamaz.
// Şema: docs/FIRESTORE_SCHEMA.md

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────── Yardımcılar ───────────────
    function signedIn()      { return request.auth != null; }
    function uid()           { return request.auth.uid; }
    function isSelf(userId)  { return signedIn() && uid() == userId; }
    // Guild yöneticileri: custom claim veya sabit UID listesi (lib/admin.ts ile aynı tutulmalı)
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || request.auth.uid in ['A3gNGw4d54T9QE3fCXfN2T5mLn63']);
    }
    function isMod()         { return isAdmin() || (signedIn() && request.auth.token.moderator == true); }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }

    function incoming()      { return request.resource.data; }
    function existing()      { return resource.data; }
    function changedKeys()   { return incoming().diff(existing()).affectedKeys(); }
    function onlyChanges(keys) { return changedKeys().hasOnly(keys); }
    function str(v, min, max)  { return v is string && v.size() >= min && v.size() <= max; }

    // Not: $(x) tek bir yol segmentidir; '/' içeren string birleştirmesi kullanılmamalı.
    function handlePath(h)  { return /databases/$(database)/documents/handles/$(h); }
    function userPath(u)    { return /databases/$(database)/documents/users/$(u); }
    function projectPath(p) { return /databases/$(database)/documents/projects/$(p); }
    function oppPath(p, o)  { return /databases/$(database)/documents/projects/$(p)/opportunities/$(o); }
    function project(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data; }
    function membership(pid) {
      return /databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid);
    }
    function isProjectMember(pid)  { return signedIn() && exists(membership(pid)); }
    function appPath(p, a)  { return /databases/$(database)/documents/projects/$(p)/applications/$(a); }
    // Proje yöneticisi: projenin managerIds listesinde veya üyelik rolü owner/admin
    function isProjectManager(pid) {
      return signedIn() && (
        uid() in project(pid).get('managerIds', [])
        || (isProjectMember(pid) && get(membership(pid)).data.role in ['owner', 'admin']));
    }
    function canManage(pid) { return isAdmin() || isProjectManager(pid); }

    // ─────────────── Kullanıcılar ───────────────
    match /users/{userId} {
      // Devre dışı bırakılmış hesaplar yalnızca sahibine ve admine görünür
      allow read: if isSelf(userId) || isAdmin()
        || (existing().get('deactivated', false) != true
            && (existing().visibility == 'public' || signedIn()));

      // İlk profil oluşturma (onboarding). Korunan alanlar başlangıç değerinde olmalı.
      allow create: if isSelf(userId)
        && incoming().uid == userId
        && str(incoming().displayName, 1, 60)
        && str(incoming().headline, 0, 120)
        && str(incoming().bio, 0, 500)
        && incoming().skills.size() <= 30
        && incoming().stats == { 'followers': 0, 'following': 0, 'posts': 0, 'projectsJoined': 0 }
        && incoming().badges.size() == 0
        && existsAfter(handlePath(incoming().handle))
        && getAfter(handlePath(incoming().handle)).data.uid == userId;

      allow update: if isSelf(userId)
        && !changedKeys().hasAny(['uid', 'stats', 'badges', 'createdAt'])
        && str(incoming().displayName, 1, 60)
        && str(incoming().headline, 0, 120)
        && str(incoming().bio, 0, 500)
        && incoming().skills.size() <= 30
        // handle değişiyorsa aynı batch'te handles/{yeni} bu kullanıcıya ait olmalı
        && (!('handle' in changedKeys())
            || getAfter(handlePath(incoming().handle)).data.uid == userId);

      allow delete: if isSelf(userId) || isAdmin(); // Ayarlar → Hesabı sil

      match /private/{docId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /experiences/{expId} {
        allow read: if get(userPath(userId)).data.visibility == 'public' || signedIn();
        allow create: if (isSelf(userId)
          && incoming().verified == false
          && incoming().type != 'guild_project'
          && incoming().source == null
          && str(incoming().title, 1, 100)
          && str(incoming().description, 0, 1000))
          // Kabul edilen başvuru için doğrulanmış Guild deneyimi (aynı batch'te başvuru 'accepted')
          || (incoming().verified == true
            && incoming().type == 'guild_project'
            && canManage(incoming().source.projectId)
            && getAfter(appPath(incoming().source.projectId,
                 incoming().source.opportunityId + '_' + userId)).data.status == 'accepted');
        // Doğrulanmış (Guild) kalemler kullanıcı tarafından düzenlenemez/silinemez
        allow update: if isSelf(userId)
          && existing().verified == false
          && !changedKeys().hasAny(['verified', 'source', 'type'])
          || (isSelf(userId) && existing().verified == true && onlyChanges(['order']));
        // Doğrulanmış kalemler düzenlenemez; ama kişi kendi CV'sinden (ve hesap silmede) kaldırabilir
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /following/{targetId} {
        allow read: if signedIn();
        allow create: if isSelf(userId) && targetId != userId
          && incoming().keys().hasOnly(['kind', 'createdAt'])
          && incoming().kind in ['user', 'project'];
        allow delete: if isSelf(userId);
        allow update: if false;
      }

      match /followers/{followerId} {
        allow read: if signedIn();
        allow write: if false; // onFollowWrite Function aynalar
      }

      // "Başvurularım" referansları (başvuruyla aynı batch'te yazılır)
      match /applications/{aid} {
        allow read, delete: if isSelf(userId);
        allow create: if isSelf(userId)
          && incoming().keys().hasOnly(['projectId', 'opportunityId', 'createdAt'])
          && aid == incoming().opportunityId + '_' + userId
          && getAfter(appPath(incoming().projectId, aid)).data.applicantId == userId;
        allow update: if false;
      }

      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow update: if isSelf(userId) && onlyChanges(['read']);
        allow delete: if isSelf(userId);
        allow create: if false;
      }

    }

    // ─────────────── Kullanıcı adı tekilliği ───────────────
    match /handles/{handle} {
      allow read: if true;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_.]{3,24}$')
        && incoming().uid == uid();
      allow delete: if signedIn() && existing().uid == uid();
      allow update: if false;
    }

    // ─────────────── Projeler ───────────────
    // Belge ID'si = slug. Guild admin projeyi açar, yöneticileri (managerIds) atar;
    // yöneticiler kendi proje sayfasını, ilanlarını ve başvurularını yönetir.
    match /projects/{pid} {
      allow read: if existing().status == 'active'
        || (signedIn() && uid() in existing().get('managerIds', []))
        || isProjectMember(pid) || isAdmin();

      allow create: if isAdmin()
        // Kullanıcı önerisi: admin onayına kadar 'pending'
        || (verifiedEmail()
          && incoming().ownerId == uid()
          && incoming().status == 'pending'
          && incoming().get('managerIds', []).size() == 0
          && str(incoming().name, 2, 60)
          && str(incoming().tagline, 0, 100)
          && getAfter(membership(pid)).data.role == 'owner');

      allow update: if isAdmin()
        || (isProjectManager(pid)
          && !changedKeys().hasAny(['status', 'ownerId', 'stats', 'createdAt', 'kind', 'managerIds', 'slug'])
          && str(incoming().name, 2, 60)
          && str(incoming().description, 0, 5000));

      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if isAdmin()
          // Proje önerisinde sahibin kendini eklemesi (bootstrap)
          || (isSelf(memberId)
            && !exists(projectPath(pid))
            && getAfter(projectPath(pid)).data.ownerId == uid()
            && incoming().role == 'owner')
          // Kabul edilen başvuran ekibe 'member' olarak eklenir (aynı batch'te başvuru 'accepted')
          || (isProjectManager(pid)
            && incoming().role == 'member'
            && getAfter(appPath(pid, incoming().viaOpportunityId + '_' + memberId)).data.status == 'accepted');
        allow update: if isAdmin() || (isProjectManager(pid) && onlyChanges(['title']));
        allow delete: if isAdmin()
          || (isProjectManager(pid) && existing().role == 'member')
          || (isSelf(memberId) && existing().role != 'owner');
      }

      match /opportunities/{oid} {
        allow read: if existing().status != 'draft' || canManage(pid);

        allow create: if canManage(pid)
          && project(pid).status == 'active'
          && incoming().projectId == pid
          && incoming().createdBy == uid()
          && incoming().status in ['draft', 'open']
          && incoming().applicationCount == 0
          && incoming().filledCount == 0
          && str(incoming().title, 3, 100)
          && str(incoming().description, 0, 8000)
          && incoming().slots is int && incoming().slots >= 1 && incoming().slots <= 50
          && incoming().questions.size() <= 10
          && incoming().links.size() <= 10;

        allow update: if canManage(pid)
          && !changedKeys().hasAny(['projectId', 'applicationCount', 'createdBy', 'createdAt'])
          && incoming().status in ['draft', 'open', 'closed', 'filled']
          && str(incoming().title, 3, 100)
          && incoming().questions.size() <= 10
          && incoming().links.size() <= 10;

        allow delete: if canManage(pid);
      }

      match /applications/{aid} {
        allow read: if signedIn() && (existing().applicantId == uid() || canManage(pid));

        // Tek tık başvuru: ID deterministik → aynı ilana tekrar başvuru imkânsız.
        allow create: if verifiedEmail()
          && aid == incoming().opportunityId + '_' + uid()
          && incoming().applicantId == uid()
          && incoming().projectId == pid
          && incoming().status == 'submitted'
          && incoming().matchScore == null
          && incoming().statusHistory.size() == 0
          && incoming().decidedBy == null
          && str(incoming().message, 0, 1000)
          && incoming().answers.size() <= 10
          && get(oppPath(pid, incoming().opportunityId)).data.status == 'open'
          && !isProjectMember(pid);

        allow update: if
          // Başvuran: karar verilmeden geri çekebilir
          (existing().applicantId == uid()
            && existing().status in ['submitted', 'in_review', 'shortlisted']
            && incoming().status == 'withdrawn'
            && onlyChanges(['status', 'updatedAt']))
          // Proje yöneticisi / admin: değerlendirme
          || (canManage(pid)
            && existing().status != 'withdrawn'
            && incoming().status in ['in_review', 'shortlisted', 'accepted', 'rejected']
            && onlyChanges(['status', 'updatedAt', 'statusHistory', 'decidedBy', 'decidedAt'])
            && incoming().statusHistory.size() == existing().statusHistory.size() + 1);

        allow delete: if isAdmin();

        match /internal/{docId} {
          allow read, write: if canManage(pid);
        }

        // Başvuranın iletişim bilgisi: başvuruyla birlikte yazılır, yöneticiye yalnızca KABUL sonrası açılır
        match /contact/{docId} {
          allow create: if signedIn() && getAfter(appPath(pid, aid)).data.applicantId == uid();
          allow delete: if signedIn() && (get(appPath(pid, aid)).data.applicantId == uid() || isAdmin());
          allow read: if signedIn() && (
            get(appPath(pid, aid)).data.applicantId == uid()
            || isAdmin()
            || (isProjectManager(pid) && get(appPath(pid, aid)).data.status == 'accepted'));
        }
      }
    }

    // Collection group sorguları: ilan tahtası + "Başvurularım" + admin paneli
    match /{path=**}/opportunities/{oid} {
      allow read: if resource.data.status in ['open', 'closed', 'filled'] || isAdmin();
    }
    match /{path=**}/applications/{aid} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isAdmin());
    }

    // ─────────────── Moderasyon / Sistem ───────────────
    // ─────────────── İletişim formu ───────────────
    match /messages/{msgId} {
      allow create: if str(incoming().name, 1, 80)
        && str(incoming().email, 3, 120) && incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(incoming().subject, 0, 120)
        && str(incoming().message, 1, 3000)
        && incoming().topic in ['genel', 'proje', 'destek', 'kvkk', 'diger']
        && incoming().status == 'new'
        && incoming().uid == (signedIn() ? uid() : null)
        && incoming().createdAt == request.time
        && incoming().keys().hasOnly(['name', 'email', 'subject', 'message', 'topic', 'status', 'uid', 'createdAt']);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && onlyChanges(['status']);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && incoming().reporterId == uid() && incoming().status == 'open';
      allow read, update: if isMod();
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
